# Docker Compose network. For native development, use the host of your local PostgreSQL.
DB_HOST=auth-db
DB_PORT=5432
DB_NAME=subsonic_auth
DB_USER=subsonic
DB_PASSWORD=replace-with-postgres-password

# Use a unique random secret with at least 32 characters.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Enable recovery email by supplying an external SMTP account and sender.
# Port 587 uses STARTTLS. Port 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Browser-facing URL for the reset link. Adjust to match the frontend deployment.
PASSWORD_RESET_URL=http://localhost:5173/recuperar-contrasena/confirmar
