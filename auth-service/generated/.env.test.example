# Copy to .env.test only for a disposable PostgreSQL database.
# The auth tests drop and recreate tables in subsonic_auth_test.
# Use auth-db instead of loopback only on an isolated Docker test network.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=subsonic_auth_test
DB_USER=subsonic_test
DB_PASSWORD=example-test-only

# conftest.py supplies dedicated JWT settings for the in-process FastAPI client.
