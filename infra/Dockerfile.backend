# Integration image; preserve the service-specific Practice 3 Dockerfiles.
FROM python:3.14-slim
ARG SERVICE
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY ${SERVICE}-service/generated/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt
COPY ${SERVICE}-service/generated /app/${SERVICE}-service/generated
COPY scripts /app/scripts
ENV PYTHONPATH=/app/${SERVICE}-service/generated/src
WORKDIR /app/${SERVICE}-service/generated
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "openapi_server.main:app", "--host", "0.0.0.0", "--port", "8000"]
